#include <stdio.h>

int main()
{
    // declaracao de variaveis
    int vetor[10];
    int i;

    // entrada
    printf("Digite 10 numeros inteiros:\n");

    for (i = 0; i < 10; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // processamento
    for (i = 0; i < 10; i++)
    {
        if (vetor[i] < 0)
            vetor[i] = 0;
    }

    // saida
    printf("\nVetor resultante:\n");

    for (i = 0; i < 10; i++)
    {
        printf("%d ", vetor[i]);
    }

    printf("\n");

    return 0;
}
