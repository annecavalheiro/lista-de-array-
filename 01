#include <stdio.h>

int main()
{
    // declaracao de variaveis
    int vetor[10];
    int maior, posicao;
    int i;

    // entrada
    printf("Digite 10 numeros inteiros:\n");

    for (i = 0; i < 10; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // processamento
    maior = vetor[0];
    posicao = 0;

    for (i = 1; i < 10; i++)
    {
        if (vetor[i] > maior)
        {
            maior = vetor[i];
            posicao = i;
        }
    }

    // saida
    printf("\nVetor digitado: ");

    for (i = 0; i < 10; i++)
    {
        printf("%d ", vetor[i]);
    }

    printf("\n\nMaior elemento: %d", maior);
    printf("\nPosicao (indice): %d\n", posicao);

    return 0;
}
