#include <stdio.h>

int main()
{
    // declaracao de constantes
    const int TAM = 10;

    // declaracao de variaveis
    int vetor[TAM];
    int num;
    int i, j;

    // entrada
    printf("Digite 10 valores numericos:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &num);

        // processamento
        j = i - 1;

        while (j >= 0 && vetor[j] > num)
        {
            vetor[j + 1] = vetor[j];
            j--;
        }

        vetor[j + 1] = num;
    }

    // saida
    printf("\nValores em ordem crescente:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("%d ", vetor[i]);
    }

    printf("\n");

    return 0;
}
