#include <stdio.h>

#define TAM 10

int main() {
    float vetor[TAM];

    // Leitura do vetor
    printf("Digite %d numeros reais (ponto flutuante):\n", TAM);
    for (int i = 0; i < TAM; i++) {
        printf("Posicao %d: ", i);
        scanf("%f", &vetor[i]);
    }

    // Ordenação (Bubble Sort)
    for (int i = 0; i < TAM - 1; i++) {
        for (int j = 0; j < TAM - 1 - i; j++) {
            if (vetor[j] > vetor[j + 1]) {
                float temp = vetor[j];
                vetor[j] = vetor[j + 1];
                vetor[j + 1] = temp;
            }
        }
    }

    // Exibição do vetor ordenado
    printf("\nVetor ordenado em ordem crescente:\n");
    for (int i = 0; i < TAM; i++) {
        printf("%.2f ", vetor[i]);
    }
    printf("\n");

    return 0;
}
