#include <stdio.h>

// funcao para verificar se o numero e primo
int ehPrimo(int n)
{
    int i;

    if (n <= 1)
        return 0;

    for (i = 2; i * i <= n; i++)
    {
        if (n % i == 0)
            return 0;
    }

    return 1;
}

int main()
{
    // declaracao de constantes
    const int TAM = 10;

    // declaracao de variaveis
    int vetor[TAM];
    int i;
    int encontrou = 0;

    // entrada
    printf("Digite 10 numeros inteiros:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // processamento e saida
    printf("\nNumeros primos e suas posicoes:\n");

    for (i = 0; i < TAM; i++)
    {
        if (ehPrimo(vetor[i]))
        {
            printf("Numero %d - posicao %d\n", vetor[i], i);
            encontrou = 1;
        }
    }

    if (encontrou == 0)
        printf("Nenhum numero primo foi digitado.\n");

    return 0;
}
