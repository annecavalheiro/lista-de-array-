#include <stdio.h>

int main()
{
    // declaracao de constantes
    const int TAM = 10;

    // declaracao de variaveis
    int vetor[TAM];
    int i, j;
    int repetido;

    // entrada
    printf("Digite 10 numeros inteiros:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // processamento
    printf("\nValores repetidos:\n");

    for (i = 0; i < TAM; i++)
    {
        repetido = 0;

        for (j = i + 1; j < TAM; j++)
        {
            if (vetor[i] == vetor[j])
            {
                repetido = 1;
                break;
            }
        }

        if (repetido == 1)
            printf("%d ", vetor[i]);
    }

    printf("\n");

    return 0;
}
