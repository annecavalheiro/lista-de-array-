#include <stdio.h>

int main()
{
    // declaracao de variaveis
    int vetor[10];
    int pares = 0;
    int i;

    // entrada
    printf("Digite 10 numeros inteiros:\n");

    for (i = 0; i < 10; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // processamento
    for (i = 0; i < 10; i++)
    {
        if (vetor[i] % 2 == 0)
            pares++;
    }

    // saida
    printf("\nO vetor possui %d valor(es) par(es).\n", pares);

    return 0;
}
