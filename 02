#include <stdio.h>

int main()
{
    // declaracao de variaveis
    int v1[100], v2[100];
    int n, temp;
    int qtd_v1 = 0;
    int qtd_v2 = 0;
    int i;

    // entrada
    do
    {
        printf("Digite a quantidade de numeros (1 a 100): ");
        scanf("%d", &n);

    } while (n < 1 || n > 100);

    printf("\nDigite %d numeros entre 0 e 50:\n", n);

    while (qtd_v1 < n)
    {
        printf("Elemento %d: ", qtd_v1 + 1);
        scanf("%d", &temp);

        if (temp >= 0 && temp <= 50)
        {
            v1[qtd_v1] = temp;

            if (temp % 2 != 0)
            {
                v2[qtd_v2] = temp;
                qtd_v2++;
            }

            qtd_v1++;
        }
        else
        {
            printf("Valor invalido!\n");
        }
    }

    // saida
    printf("\nPrimeiro vetor:\n");

    for (i = 0; i < qtd_v1; i++)
    {
        printf("%d\t", v1[i]);

        if ((i + 1) % 10 == 0)
            printf("\n");
    }

    printf("\nVetor de impares:\n");

    if (qtd_v2 == 0)
    {
        printf("Nenhum numero impar foi digitado.\n");
    }
    else
    {
        for (i = 0; i < qtd_v2; i++)
        {
            printf("%d\t", v2[i]);

            if ((i + 1) % 10 == 0)
                printf("\n");
        }
    }

    return 0;
}
